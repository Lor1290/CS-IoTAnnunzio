@page "/devices/{DeviceId:int}"
@inject AuthService Auth
@inject DatabaseService Db
@inject NavigationManager Nav
@inject ProtectedLocalStorage Storage
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_device?.Name ?? "Dispositivo") — IoT Monitor</PageTitle>

@if (!_ready)
{
    <div class="loading-screen"><div class="spinner-lg"></div></div>
}
else if (_device == null)
{
    <div class="page-content"><p>Dispositivo non trovato.</p></div>
}
else
{
    <div class="page-content">
        <div class="page-header">
            <div>
                <a href="/devices" class="back-link">← Dispositivi</a>
                <h1>@_device.Name</h1>
                <p class="subtitle">📍 @(_device.Location ?? "—") &nbsp;|&nbsp; ID: @_device.Esp32SerialId</p>
            </div>
            <span class="status-pill @_device.Status lg">@_device.Status.ToUpper()</span>
        </div>

        <!-- SENSOR CARDS -->
        <div class="sensor-grid">
            @foreach (var sensor in _device.Sensors)
            {
                var reading = _liveReadings.TryGetValue(sensor.Id, out var r) ? r
                              : sensor.LatestReading;

                bool overMax = reading != null && sensor.MaxThreshold.HasValue && reading.Value > sensor.MaxThreshold;
                bool underMin = reading != null && sensor.MinThreshold.HasValue && reading.Value < sensor.MinThreshold;
                string alertClass = (overMax || underMin) ? "threshold-breach" : "";

                <div class="sensor-card @alertClass">
                    <div class="sensor-header">
                        <span class="sensor-type-icon">@GetSensorIcon(sensor.Type)</span>
                        <div>
                            <h3>@sensor.Label</h3>
                            <small>@sensor.Type</small>
                        </div>
                        @if (overMax || underMin)
                        {
                            <span class="sensor-warning">⚠ Soglia!</span>
                        }
                    </div>

                    <div class="sensor-value">
                        @if (reading != null)
                        {
                            <span class="value">@reading.Value.ToString("F1")</span>
                            <span class="unit">@(sensor.Unit ?? "")</span>
                        }
                        else
                        {
                            <span class="no-data">— No data</span>
                        }
                    </div>

                    <div class="sensor-thresholds">
                        @if (sensor.MinThreshold.HasValue)
                        {
                            <span class="threshold min">Min: @sensor.MinThreshold</span>
                        }
                        @if (sensor.MaxThreshold.HasValue)
                        {
                            <span class="threshold max">Max: @sensor.MaxThreshold</span>
                        }
                    </div>

                    @if (reading != null)
                    {
                        <div class="sensor-ts">
                            @reading.Timestamp.ToString("HH:mm:ss")
                        </div>
                    }
                </div>
            }
        </div>

        <!-- LIVE FEED -->
        <h2 class="section-title">Feed in tempo reale</h2>
        <div class="live-feed">
            @foreach (var entry in _feed.Take(30))
            {
                <div class="feed-row">
                    <span class="feed-ts">@entry.Timestamp.ToString("HH:mm:ss")</span>
                    <span class="feed-label">@entry.Label</span>
                    <span class="feed-value">@entry.Value.ToString("F2") @entry.Unit</span>
                </div>
            }
            @if (!_feed.Any())
            {
                <p class="no-data-msg">In attesa di nuove letture…</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int DeviceId { get; set; }

    private bool _ready = false;
    private Device? _device;

    // sensor_id → latest live reading
    private Dictionary<int, SensorReading> _liveReadings = new();

    // ordered live feed (newest first)
    private record FeedEntry(string Label, decimal Value, string? Unit, DateTime Timestamp);
    private List<FeedEntry> _feed = new();

    private HubConnection? _hub;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var ok = await Auth.RestoreSessionAsync(Storage);
        if (!ok) { Nav.NavigateTo("/login"); return; }

        _device = await Db.GetDeviceWithSensorsAsync(DeviceId);
        _ready  = true;
        StateHasChanged();

        if (_device != null)
            await ConnectSignalRAsync();
    }

    private async Task ConnectSignalRAsync()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/sensors"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<object>("NewReading", data =>
        {
            // deserialize anonymous object from SignalR
            var json = System.Text.Json.JsonSerializer.Serialize(data);
            var doc  = System.Text.Json.JsonDocument.Parse(json).RootElement;

            var sensorId    = doc.GetProperty("sensorId").GetInt32();
            var sensorLabel = doc.GetProperty("sensorLabel").GetString() ?? "";
            var unit        = doc.GetProperty("unit").GetString();
            var value       = doc.GetProperty("value").GetDecimal();
            var timestamp   = doc.GetProperty("timestamp").GetDateTime();

            _liveReadings[sensorId] = new SensorReading
            {
                SensorId  = sensorId,
                Value     = value,
                Timestamp = timestamp
            };

            _feed.Insert(0, new FeedEntry(sensorLabel, value, unit, timestamp));
            if (_feed.Count > 100) _feed.RemoveAt(_feed.Count - 1);

            InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
        await _hub.InvokeAsync("JoinDevice", DeviceId);
    }

    private static string GetSensorIcon(string type) => type.ToLower() switch
    {
        "temperature" => "🌡",
        "humidity"    => "💧",
        "pressure"    => "🔵",
        "gas"         => "💨",
        "flood"       => "🌊",
        "motion"      => "🔴",
        "light"       => "☀",
        _             => "📡"
    };

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
        {
            await _hub.InvokeAsync("LeaveDevice", DeviceId);
            await _hub.DisposeAsync();
        }
    }
}
