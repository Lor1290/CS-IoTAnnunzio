@page "/"
@inject AuthService Auth
@inject DatabaseService Db
@inject NavigationManager Nav
@inject ProtectedLocalStorage Storage

<PageTitle>Dashboard — IoT Monitor</PageTitle>

@if (!_ready)
{
    <div class="loading-screen"><div class="spinner-lg"></div></div>
}
else if (!Auth.IsAuthenticated)
{
    <!-- redirect handled in OnAfterRenderAsync -->
}
else
{
    <div class="page-dashboard">

        <!-- HEADER -->
        <div class="page-header">
            <div>
                <h1>Dashboard</h1>
                <p class="subtitle">Benvenuto, @Auth.CurrentUser?.FullName</p>
            </div>
            <div class="last-update">
                Aggiornato: @_lastUpdate.ToString("HH:mm:ss")
            </div>
        </div>

        <!-- STAT CARDS -->
        @if (_stats != null)
        {
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon online">◉</div>
                    <div class="stat-body">
                        <span class="stat-value">@_stats.OnlineDevices / @_stats.TotalDevices</span>
                        <span class="stat-label">Dispositivi Online</span>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon sensor">◈</div>
                    <div class="stat-body">
                        <span class="stat-value">@_stats.TotalSensors</span>
                        <span class="stat-label">Sensori Totali</span>
                    </div>
                </div>
                <div class="stat-card @(_stats.ActiveAlerts > 0 ? "alert-active" : "")">
                    <div class="stat-icon @(_stats.ActiveAlerts > 0 ? "danger" : "ok")">⚠</div>
                    <div class="stat-body">
                        <span class="stat-value">@_stats.ActiveAlerts</span>
                        <span class="stat-label">Alert Attivi</span>
                    </div>
                </div>
            </div>
        }

        <!-- DEVICE CARDS -->
        <h2 class="section-title">Dispositivi</h2>
        <div class="device-grid">
            @foreach (var device in _devices)
            {
                <div class="device-card @device.Status" @onclick="() => GoToDevice(device.Id)">
                    <div class="device-card-header">
                        <span class="device-status-dot"></span>
                        <h3>@device.Name</h3>
                        <span class="device-badge @device.Status">@device.Status.ToUpper()</span>
                    </div>
                    <div class="device-card-body">
                        <p class="device-location">📍 @(device.Location ?? "Posizione non impostata")</p>
                        <p class="device-serial">ID: @device.Esp32SerialId</p>
                        @if (device.LastSeen.HasValue)
                        {
                            <p class="device-lastseen">
                                Ultimo contatto: @device.LastSeen.Value.ToString("dd/MM HH:mm")
                            </p>
                        }
                    </div>
                    <div class="device-card-footer">
                        <span class="link-detail">Vai ai dettagli →</span>
                    </div>
                </div>
            }
        </div>

        <!-- RECENT ALERTS -->
        @if (_alerts.Any())
        {
            <h2 class="section-title">Alert Recenti</h2>
            <div class="alert-list">
                @foreach (var alert in _alerts.Take(5))
                {
                    <div class="alert-row severity-@alert.Severity.ToLower()">
                        <span class="alert-severity">@alert.Severity.ToUpper()</span>
                        <div class="alert-info">
                            <strong>@alert.DeviceName</strong> — @alert.SensorLabel
                            <span class="alert-msg">@alert.Message</span>
                        </div>
                        <span class="alert-time">@alert.TriggeredAt.ToString("dd/MM HH:mm")</span>
                    </div>
                }
                <a href="/alerts" class="view-all">Vedi tutti gli alert →</a>
            </div>
        }
    </div>
}

@code {
    private bool _ready = false;
    private DashboardStats? _stats;
    private List<Device> _devices = new();
    private List<Alert> _alerts = new();
    private DateTime _lastUpdate;
    private Timer? _timer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var ok = await Auth.RestoreSessionAsync(Storage);
        if (!ok)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadDataAsync();
        _ready = true;
        StateHasChanged();

        // auto-refresh every 10 seconds
        _timer = new Timer(async _ =>
        {
            await LoadDataAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadDataAsync()
    {
        _stats   = await Db.GetDashboardStatsAsync();
        _devices = await Db.GetDevicesAsync();
        _alerts  = await Db.GetAlertsAsync(onlyActive: true);
        _lastUpdate = DateTime.Now;
    }

    private void GoToDevice(int id) => Nav.NavigateTo($"/devices/{id}");

    public void Dispose() => _timer?.Dispose();
}
