@page "/devices"
@inject AuthService Auth
@inject DatabaseService Db
@inject NavigationManager Nav
@inject ProtectedLocalStorage Storage

<PageTitle>Dispositivi — IoT Monitor</PageTitle>

@if (!_ready)
{
    <div class="loading-screen"><div class="spinner-lg"></div></div>
}
else
{
    <div class="page-content">
        <div class="page-header">
            <h1>Dispositivi</h1>
            <span class="badge">@_devices.Count totali</span>
        </div>

        <div class="device-table-wrapper">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Stato</th>
                        <th>Nome</th>
                        <th>Posizione</th>
                        <th>Serial ID</th>
                        <th>Ultimo contatto</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _devices)
                    {
                        <tr class="@d.Status">
                            <td><span class="status-pill @d.Status">@d.Status</span></td>
                            <td><strong>@d.Name</strong></td>
                            <td>@(d.Location ?? "—")</td>
                            <td class="mono">@d.Esp32SerialId</td>
                            <td>@(d.LastSeen?.ToString("dd/MM/yy HH:mm") ?? "Mai")</td>
                            <td>
                                <button class="btn btn-sm" @onclick="() => GoToDevice(d.Id)">
                                    Dettagli
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool _ready = false;
    private List<Device> _devices = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var ok = await Auth.RestoreSessionAsync(Storage);
        if (!ok) { Nav.NavigateTo("/login"); return; }

        _devices = await Db.GetDevicesAsync();
        _ready = true;
        StateHasChanged();
    }
}
