@inherits LayoutComponentBase
@inject AuthService Auth
@inject NavigationManager Nav

<div class="app-shell @(Auth.IsAuthenticated ? "authenticated" : "guest")">

    @if (Auth.IsAuthenticated)
    {
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon">⚡</span>
                <span class="brand-text">IoT Monitor</span>
            </div>

            <ul class="nav-links">
                <li>
                    <NavLink href="/" Match="NavLinkMatch.All">
                        <span class="nav-icon">◼</span> Dashboard
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/devices">
                        <span class="nav-icon">◉</span> Dispositivi
                    </NavLink>
                </li>
                <li>
                    <NavLink href="/alerts">
                        <span class="nav-icon">◈</span> Alert
                    </NavLink>
                </li>
            </ul>

            <div class="sidebar-footer">
                <span class="user-name">@Auth.CurrentUser?.FullName</span>
                <button class="btn-logout" @onclick="Logout">Esci</button>
            </div>
        </nav>

        <!-- Top bar (mobile) -->
        <header class="topbar">
            <button class="menu-toggle" @onclick="ToggleSidebar">☰</button>
            <span class="topbar-title">IoT Monitor</span>
        </header>
    }

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool _sidebarOpen = false;

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private async Task Logout()
    {
        // AuthService.LogoutAsync requires ProtectedLocalStorage which is injected in pages
        // We navigate to the logout page instead
        Nav.NavigateTo("/logout");
    }
}
