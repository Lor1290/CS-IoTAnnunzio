@page "/"
@inject SensorService SensorSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@implements IAsyncDisposable
@rendermode InteractiveServer

<PageTitle>Dashboard — IoT Annunzio</PageTitle>

@if (!_authenticated)
{
    <MudText>Reindirizzamento...</MudText>
    return;
}

<MudText Typo="Typo.h4" Class="mb-2">Dashboard</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Benvenuto, <b>@_userName</b> — aggiornamento ogni 3 secondi
</MudText>

@* ── Active Alerts ── *@
@if (_alerts.Any())
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        <MudText Typo="Typo.subtitle2">@_alerts.Count alert attivi</MudText>
        @foreach (var a in _alerts.Take(3))
        {
            <MudText Typo="Typo.body2">• [@a.Severity.ToUpper()] @a.SensorLabel — @a.Message</MudText>
        }
    </MudAlert>
}

@* ── Sensor Cards ── *@
<MudGrid>
    @foreach (var sensor in _sensors)
    {
        var reading = _latest.GetValueOrDefault(sensor.Id);
        var value   = reading is not null ? $"{reading.Value:F1} {sensor.Unit}" : "—";
        var color   = GetCardColor(sensor, reading);

        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="2" Style="cursor:pointer" @onclick="() => GoToDetail(sensor.Id)">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudStack>
                            <MudText Typo="Typo.overline" Color="Color.Secondary">@sensor.Type.ToUpper()</MudText>
                            <MudText Typo="Typo.h6">@sensor.Label</MudText>
                            <MudText Typo="Typo.h4" Color="@color">@value</MudText>
                        </MudStack>
                        <MudIcon Icon="@GetIcon(sensor.Type)" Color="@color" Size="Size.Large" />
                    </MudStack>

                    @if (reading is not null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                            @reading.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    bool _authenticated;
    string _userName = string.Empty;

    List<project.Models.Sensor> _sensors = new();
    Dictionary<int, project.Models.SensorReading> _latest = new();
    List<project.Models.Alert> _alerts = new();

    HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        var email = Http.HttpContext?.Session.GetString("user_email");
        if (string.IsNullOrEmpty(email)) { Nav.NavigateTo("/login"); return; }
        _userName      = Http.HttpContext?.Session.GetString("user_name") ?? email;
        _authenticated = true;

        _sensors = await SensorSvc.GetSensorsAsync();
        _latest  = await SensorSvc.GetLatestReadingsAsync();
        _alerts  = await SensorSvc.GetActiveAlertsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_authenticated) return;

        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/sensors"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<Dictionary<int, project.Models.SensorReading>, List<project.Models.Alert>>(
            "ReceiveUpdate",
            (latest, alerts) =>
            {
                _latest = latest;
                _alerts = alerts;
                InvokeAsync(StateHasChanged);
            });

        await _hub.StartAsync();
        await _hub.InvokeAsync("Subscribe");
    }

    void GoToDetail(int sensorId) => Nav.NavigateTo($"/sensor/{sensorId}");

    Color GetCardColor(project.Models.Sensor s, project.Models.SensorReading? r)
    {
        if (r is null) return Color.Default;
        if (s.MaxThreshold.HasValue && r.Value > s.MaxThreshold) return Color.Error;
        if (s.MinThreshold.HasValue && r.Value < s.MinThreshold) return Color.Warning;
        return Color.Success;
    }

    string GetIcon(string type) => type switch
    {
        "temperature" => Icons.Material.Filled.Thermostat,
        "humidity"    => Icons.Material.Filled.WaterDrop,
        "pressure"    => Icons.Material.Filled.Speed,
        "light"       => Icons.Material.Filled.LightMode,
        "gas"         => Icons.Material.Filled.Air,
        "wind"        => Icons.Material.Filled.Toys,
        "water"       => Icons.Material.Filled.Water,
        _             => Icons.Material.Filled.Sensors,
    };

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null) await _hub.DisposeAsync();
    }
}
