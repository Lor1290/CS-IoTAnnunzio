@page "/"
@inject SharedUserStore UserStore
@inject IEmailVerificationSender EmailSender
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>User Panel</PageTitle>

<div class="user-shell">
    @if (!_isAuthenticated)
    {
        <section class="login-stage user-login-stage">
            <div class="login-card user-login-card">
                <p class="eyebrow"><i>Dalla parola al dato, tutto è connesso</i></p>
                <h1>Dashboard</h1>

                <div class="field-grid">
                    <label for="user-email">Email</label>
                    <input id="user-email" class="form-control" @bind-value="_login.Email" @bind-value:event="oninput" placeholder="mario@iot.local" />

                    <label for="user-password">Password</label>
                    <input id="user-password" class="form-control" type="password" @bind-value="_login.Password" @bind-value:event="oninput" placeholder="Mario1234!" />
                </div>

                <div class="button-row">
                    <button type="button" class="primary-button" @onclick="RequestVerificationCode">Invia codice</button>
                </div>
                @if (!string.IsNullOrEmpty(_debugError))
                {
                    <p style="color:red">@_debugError</p>
                }

                @if (_isVerificationStep)
                {
                    <div class="verification-card">
                        <label for="verification-code">Codice verifica</label>
                        <input id="verification-code" class="form-control" @bind-value="_verificationCodeInput" @bind-value:event="oninput" placeholder="000000" />
                        <button type="button" class="secondary-button" @onclick="ConfirmVerificationCode">Conferma e accedi</button>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <section class="dashboard-shell">
            <aside class="sidebar-panel">
                <div>
                    <p class="eyebrow">Menu utente</p>
                    <h1>@_currentAccount.FullName</h1>
                    <p class="muted">@_currentAccount.Email</p>
                </div>

                <nav class="sidebar-nav">
                    <button type="button" class="sidebar-link @GetSectionClass(UserSection.Overview)" @onclick="() => SetSection(UserSection.Overview)">Grafici</button>
                    <button type="button" class="sidebar-link @GetSectionClass(UserSection.Account)" @onclick="() => SetSection(UserSection.Account)">Account</button>
                </nav>
                <button type="button" class="logout-button" @onclick="Logout">Esci</button>
            </aside>

            <section class="dashboard-main">
                <header class="dashboard-hero">
                    <div>
                        <p class="eyebrow">Benvenuto</p>
                        <h2>Dashboard Sensori</h2>
                    </div>
                    <div class="hero-actions">
                        <div class="pill">Profilo: @_currentAccount.Username</div>
                    </div>
                </header>

                @switch (_activeSection)
                {
                    case UserSection.Overview:
                        @if (_isLoadingData)
                        {
                            <p class="muted">Caricamento dati...</p>
                        }
                        else
                        {
                            <section class="main-grid">
                                <div class="chart-area">
                                    <article class="big-chart chart-card">
                                        <div class="card-heading">
                                            <div>
                                                <p class="eyebrow">Sensori</p>
                                                <h3>Ultima lettura per sensore</h3>
                                            </div>
                                            <span class="tag">@_sensors.Count sensori</span>
                                        </div>

                                        <div class="chart-list">
                                            @foreach (var s in _sensors)
                                            {
                                                <div class="chart-row">
                                                    <div class="chart-labels">
                                                        <strong>
                                                            @(s.Label == "DHT22 Temperatura"  ? "Sensore Temperatura 1" :
                                                            s.Label == "DHT22 Umidità"      ? "Sensore Umidità 1"     :
                                                            s.Label == "BMP180 Temperatura" ? "Sensore Temperatura 2" :
                                                            s.Label == "BMP180 Pressione"   ? "Pressione Atmosferica" :
                                                            s.Label == "NTC Temperatura"    ? "Sensore Temperatura 3" :
                                                            s.Label == "Luminosità"         ? "Luminosità Ambiente"   :
                                                            s.Label == "Gas"                ? "Rilevatore Gas"        :
                                                            s.Label == "Vento"              ? "Rilevatore Vento"      :
                                                            s.Label == "Acqua"              ? "Rilevatore Acqua"      : s.Label)
                                                        </strong>
                                                        <span>@s.Type</span>
                                                    </div>
                                                     @if (s.Type != "gas" && s.Type != "wind" && s.Type != "water") {
                                                        <div class="chart-track">
                                                            <div class="chart-fill" style="width:@(s.Percentage)%"></div>
                                                        </div>
                                                    }
                                                    <div class="chart-value">
                                                         <strong>
                                                            @(!s.HasValue ? "—" :
                                                            s.Type == "pressure" ? $"{(s.Value!.Value / 100m):F1} hPa" :
                                                            s.Type == "light"    ? (s.Value!.Value < 10   ? "Buio" :
                                                                                    s.Value!.Value < 100  ? "Molto scarso" :
                                                                                    s.Value!.Value < 500  ? "Poco luminoso" :
                                                                                    s.Value!.Value < 2000 ? "Semi luminoso" :
                                                                                    s.Value!.Value < 5000 ? "Luminoso" :
                                                                                                            "Molto luminoso") :
                                                            s.Type == "gas"      ? (s.Value!.Value > 0.5m ? "Concentrazione elevata" :
                                                                                    s.Value!.Value > 0.2m ? "Attenzione" : "Normale") :
                                                            s.Type == "wind"     ? (s.Value!.Value > 0.5m ? "Vento presente" : "Assente") :
                                                            s.Type == "water"    ? (s.Value!.Value >= 1m  ? "Allagamento rilevato" : "Nessuna perdita") :
                                                            $"{s.Value!.Value:F1} {s.Unit}")
                                                        </strong>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </article>

                                    <div class="bottom-grids">
                                        <article class="table-card panel-card">
                                            <div class="card-heading">
                                                <div>
                                                    <p class="eyebrow">Allarmi attivi</p>
                                                    <h3>Ultime notifiche</h3>
                                                </div>
                                            </div>
                                            <div class="stack-list">
                                                @if (!_alerts.Any())
                                                {
                                                    <p class="muted">Nessun allarme attivo.</p>
                                                }
                                                @foreach (var alert in _alerts)
                                                {
                                                    <div class="stack-item">
                                                        <div>
                                                            <strong>@alert.SensorLabel</strong>
                                                            <p class="muted">@alert.Message</p>
                                                        </div>
                                                        <span class="status-dot @(alert.Severity == "critical" ? "offline" : "neutral")">
                                                            @alert.Severity
                                                        </span>
                                                    </div>
                                                }
                                            </div>
                                        </article>
                                    </div>
                                </div>
                            </section>
                        }
                        break;

                    case UserSection.Account:
                        <section class="account-layout">
                            <article class="panel-card account-card">
                                <div class="card-heading">
                                    <div>
                                        <p class="eyebrow">Account</p>
                                        <h3>Informazioni profilo</h3>
                                    </div>
                                </div>
                                <dl class="account-dl">
                                    <div><dt>Nome</dt><dd>@_currentAccount.FullName</dd></div>
                                    <div><dt>Email</dt><dd>@_currentAccount.Email</dd></div>
                                    <div><dt>Device</dt><dd>@_currentAccount.DeviceName</dd></div>
                                </dl>
                            </article>

                            <article class="panel-card account-card">
                                <div class="card-heading">
                                    <div>
                                        <p class="eyebrow">Sicurezza</p>
                                        <h3>Modifica password</h3>
                                    </div>
                                </div>
                                <EditForm Model="_passwordForm" OnValidSubmit="UpdatePassword">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <div class="field-grid compact">
                                        <label>Password attuale</label>
                                        <InputText class="form-control" type="password" @bind-Value="_passwordForm.CurrentPassword" />
                                        <label>Nuova password</label>
                                        <InputText class="form-control" type="password" @bind-Value="_passwordForm.NewPassword" />
                                        <label>Conferma password</label>
                                        <InputText class="form-control" type="password" @bind-Value="_passwordForm.ConfirmPassword" />
                                    </div>
                                    <div class="button-row">
                                        <button type="submit" class="primary-button">Aggiorna</button>
                                    </div>
                                </EditForm>
                            </article>
                        </section>
                        break;
                }
            </section>
        </section>
    }
</div>

@code {
    private readonly LoginModel _login = new();
    private readonly PasswordFormModel _passwordForm = new();
    private List<DashboardAccount> _accounts = [];
    private DashboardAccount _currentAccount = new();
    private UserSection _activeSection = UserSection.Overview;

    private List<SensorWithLatestReading> _sensors = [];
    private List<AlertRecord> _alerts = [];
    private bool _isLoadingData = false;

    private string _verificationCode = string.Empty;
    private string _verificationCodeInput = string.Empty;
    private bool _isAuthenticated;
    private bool _isVerificationStep;

    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        try {
            _accounts = await LoadAccountsAsync();
        } catch (Exception ex) {
            Snackbar.Add($"Errore di connessione: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        _isLoadingData = true;
        try {
            var record = await UserStore.FindByEmailAsync(_currentAccount.Email);
            if (record is not null) {
                _sensors = await UserStore.GetSensorReadingsAsync(record.Id);
                _alerts  = await UserStore.GetActiveAlertsAsync(record.Id);

                if (_alerts.Any())
                    Snackbar.Add($"{_alerts.Count} allarme/i attivo/i sul tuo device.", Severity.Warning);
            }
        } catch (Exception ex) {
            Snackbar.Add($"Errore caricamento dati: {ex.Message}", Severity.Error);
        } finally {
            _isLoadingData = false;
        }
    }

    private async Task RequestVerificationCode()
    {
        try {
            _accounts = await LoadAccountsAsync();

            var account = _accounts.FirstOrDefault(item =>
                string.Equals(item.Email, _login.Email.Trim(), StringComparison.OrdinalIgnoreCase));

            var passwordValid = account is not null && (
                account.Password.StartsWith("$2")
                    ? BCrypt.Net.BCrypt.Verify(_login.Password, account.Password)
                    : account.Password == _login.Password
            );

            if (!passwordValid) {
                Snackbar.Add("Credenziali non valide.", Severity.Error);
                _isVerificationStep = false;
                return;
            }

            _currentAccount = account;
            _verificationCode = Random.Shared.Next(100000, 999999).ToString();
            _verificationCodeInput = string.Empty;

            await EmailSender.SendVerificationCodeAsync(_currentAccount.Email, _currentAccount.FullName, _verificationCode);
            _isVerificationStep = true;
            Snackbar.Add($"Codice inviato a {_currentAccount.Email}.", Severity.Info);

        } catch (Exception ex) {
            _isVerificationStep = false;
            _debugError = ex.Message;
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmVerificationCode()
    {
        if (!_isVerificationStep) return;

        if (!string.Equals(_verificationCodeInput.Trim(), _verificationCode, StringComparison.Ordinal)) {
            Snackbar.Add("Codice non corretto.", Severity.Error);
            return;
        }

        _isAuthenticated = true;
        _isVerificationStep = false;
        Snackbar.Add($"Benvenuto {_currentAccount.FullName}.", Severity.Success);
        await LoadDashboardDataAsync();
        StateHasChanged();

        _refreshTimer = new System.Threading.Timer(async _ => {
            await LoadDashboardDataAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private void SetSection(UserSection section) => _activeSection = section;
    private string GetSectionClass(UserSection section) => _activeSection == section ? "is-active" : string.Empty;

    private async Task UpdatePassword()
    {
        try {
            var currentValid = _currentAccount.Password.StartsWith("$2")
                ? BCrypt.Net.BCrypt.Verify(_passwordForm.CurrentPassword, _currentAccount.Password)
                : _currentAccount.Password == _passwordForm.CurrentPassword;

            if (!currentValid) {
                Snackbar.Add("La password attuale non è corretta.", Severity.Error);
                return;
            }

            _currentAccount.Password = BCrypt.Net.BCrypt.HashPassword(_passwordForm.NewPassword);
            await UserStore.UpsertAsync(MapToRecord(_currentAccount));
            _accounts = await LoadAccountsAsync();

            _passwordForm.CurrentPassword = string.Empty;
            _passwordForm.NewPassword = string.Empty;
            _passwordForm.ConfirmPassword = string.Empty;

            Snackbar.Add("Password aggiornata con successo.", Severity.Success);
        } catch (Exception ex) {
            Snackbar.Add($"Errore: {ex.Message}", Severity.Error);
        }
    }

    private async Task<List<DashboardAccount>> LoadAccountsAsync()
    {
        var records = await UserStore.GetAllAsync();
        return records.Select(MapFromRecord).OrderBy(a => a.Username).ToList();
    }

    private static DashboardAccount MapFromRecord(SharedUserRecord r) => new() {
        Id = r.Id,
        Username = r.Username,
        FullName = r.FullName,
        Email = r.Email,
        Password = r.Password,
        DeviceName = r.DeviceName,
        DeviceLocation = r.DeviceLocation,
        DeviceStatus = r.DeviceStatus
    };

    private static SharedUserRecord MapToRecord(DashboardAccount a) => new() {
        Id = a.Id,
        Username = a.Username,
        FullName = a.FullName,
        Email = a.Email,
        Password = a.Password,
        DeviceName = a.DeviceName,
        DeviceLocation = a.DeviceLocation,
        DeviceStatus = a.DeviceStatus
    };

    private sealed class LoginModel {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    private sealed class PasswordFormModel {
        public string CurrentPassword { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class DashboardAccount {
        public int Id { get; set; }
        public string Username { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string DeviceName { get; set; } = string.Empty;
        public string DeviceLocation { get; set; } = string.Empty;
        public string DeviceStatus { get; set; } = string.Empty;
    }

    private enum UserSection { Overview, Account }

    private void Logout()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;
        _isAuthenticated = false;
        _isVerificationStep = false;
        _currentAccount = new DashboardAccount();
        _sensors = [];
        _alerts = [];
        _login.Email = string.Empty;
        _login.Password = string.Empty;
        Snackbar.Add("Disconnesso con successo.", Severity.Info);
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private string _debugError = string.Empty;
}