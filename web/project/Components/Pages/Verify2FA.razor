@page "/verify"
@inject AuthService Auth
@inject NavigationManager Nav
@inject IHttpContextAccessor Http
@rendermode InteractiveServer

<PageTitle>Verifica — IoT Annunzio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="4" Class="pa-8">
        <MudStack AlignItems="AlignItems.Center" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h5">Verifica in due passaggi</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                Abbiamo inviato un codice a <b>@_email</b>
            </MudText>
        </MudStack>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField @bind-Value="_code"
                      Label="Codice a 6 cifre"
                      Variant="Variant.Outlined"
                      InputType="InputType.Number"
                      Class="mb-6"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Pin" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Size="Size.Large"
                   OnClick="HandleVerify"
                   Disabled="_loading">
            @if (_loading) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Verifica
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   FullWidth="true"
                   Class="mt-2"
                   OnClick="Resend">
            Reinvia codice
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? email { get; set; }
    [SupplyParameterFromQuery] public string? name  { get; set; }

    string _email => email ?? string.Empty;
    string _code  = string.Empty;
    string? _error;
    bool _loading;

    async Task HandleVerify()
    {
        _error   = null;
        _loading = true;

        if (Auth.VerifyTwoFactorCode(_email, _code.Trim()))
        {
            Nav.NavigateTo($"/auth/session?email={Uri.EscapeDataString(_email)}&name={Uri.EscapeDataString(name ?? _email)}", forceLoad: true);
        }
        else
        {
            _error   = "Codice non valido o scaduto.";
            _loading = false;
        }
    }

    async Task Resend()
    {
        await Auth.SendTwoFactorCodeAsync(_email, name ?? _email);
    }
}
