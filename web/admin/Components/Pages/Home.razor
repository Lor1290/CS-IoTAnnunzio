@page "/"
@inject AdminService Admin
@rendermode InteractiveServer

<PageTitle>Utenti — IoT Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
    <MudText Typo="Typo.h5">Utenti registrati</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               Href="/add-user">
        Aggiungi utente
    </MudButton>
</MudStack>

@if (_users is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!_users.Any())
{
    <MudAlert Severity="Severity.Info">Nessun utente nel database.</MudAlert>
}
else
{
    <MudTable Items="_users" Hover="true" Striped="true" Elevation="2">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Nome</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Ruolo</MudTh>
            <MudTh>Azioni</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Id</MudTd>
            <MudTd>@context.FullName</MudTd>
            <MudTd>@context.Email</MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@(context.Role == "admin" ? Color.Warning : Color.Default)">
                    @context.Role
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               OnClick="() => ConfirmDelete(context.Id, context.Email)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@* Delete confirmation dialog *@
<MudDialog @bind-Visible="_deleteDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">Conferma eliminazione</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Eliminare l'utente <b>@_deleteEmail</b>?</MudText>
        <MudText Typo="Typo.body2" Color="Color.Error">
            Questa operazione non può essere annullata.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteDialog = false">Annulla</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="DoDelete">Elimina</MudButton>
    </DialogActions>
</MudDialog>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@code {
    List<(int Id, string Email, string FullName, string Role)>? _users;
    bool   _deleteDialog;
    int    _deleteId;
    string _deleteEmail = string.Empty;
    string? _error;

    protected override async Task OnInitializedAsync() =>
        _users = await Admin.GetUsersAsync();

    void ConfirmDelete(int id, string email)
    {
        _deleteId    = id;
        _deleteEmail = email;
        _deleteDialog = true;
    }

    async Task DoDelete()
    {
        _deleteDialog = false;
        var err = await Admin.DeleteUserAsync(_deleteId);
        if (string.IsNullOrEmpty(err))
            _users = await Admin.GetUsersAsync();
        else
            _error = err;
    }
}
