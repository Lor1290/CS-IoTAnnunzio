@page "/"

@inject ISnackbar SnackBar;
@inject SharedUserStore UserStore

<PageTitle>Admin Panel</PageTitle>

<div class="admin-shell">
	@if (!_isUnlocked) {
		<section class="login-stage">
			<div class="login-card">
				<p class="eyebrow"><i>Dalla parola al dato, tutto è connesso</i></p>
				<h1>Pannello Di Controllo</h1>

				<div class="field-grid">
					<label for="admin-name">Nome</label>
					<input id="admin-name" class="form-control" @bind-value="_login.Username" @bind-value:event="oninput" placeholder="example@gmail.com" />

					<label for="admin-password">Password</label>
					<input id="admin-password" class="form-control" type="password" @bind-value="_login.Password" @bind-value:event="oninput" placeholder="adminPaSsWoRd123" />
				</div>

				<div class="button-row">
					<button type="button" class="primary-button" @onclick="AttemptLogin">Accedi</button>
				</div>
			</div>
		</section>
	} else {
		<section class="admin-dashboard">
			<header class="admin-hero">
				<div>
					<p class="eyebrow">Gestione utenti</p>
					<h1>Console amministrativa</h1>
					<p class="muted">Cerca per username, modifica le anagrafiche, collega il device o aggiungi un nuovo utente.</p>
				</div>

				<div class="hero-actions">
					<div class="pill">Utenti: @_users.Count</div>
				</div>
			</header>

			<div class="admin-toolbar">
				<input class="form-control search-input" @bind-value="_searchTerm" @bind-value:event="oninput" placeholder="username, email o device" />
				<button type="button" class="primary-button" @onclick="BeginCreate">Add</button>
			</div>

			<div class="admin-grid">
				<div class="users-list">
					@foreach (var user in FilteredUsers) {
						<article class="user-card @( _editingUserId == user.Id ? "is-selected" : string.Empty)">
							<div class="user-card-header">
								<div>
									<span class="tag">@user.Username</span>
									<h2>@user.FullName</h2>
									<p class="muted">@user.Email</p>
								</div>
							</div>

							<div class="meta-grid">
								<div>
									<span>Device</span>
									<strong>@user.DeviceName</strong>
								</div>
								<div>
									<span>Location</span>
									<strong>@user.DeviceLocation</strong>
								</div>
								<div>
									<span>Stato</span>
									<strong>@user.DeviceStatus</strong>
								</div>
							</div>

							<div class="card-actions">
								<button type="button" class="secondary-button" @onclick="() => BeginEdit(user)">Modifica</button>
								<button type="button" class="danger-button"    @onclick="() => DeleteUser(user.Id)">Cancella</button>
							</div>
						</article>
					}

					@if (!FilteredUsers.Any()) {
						<article class="empty-state">
							<h2>Nessun utente trovato</h2>
							<p>Prova con un altro username, un'altra email oppure aggiungi un nuovo record.</p>
						</article>
					}
				</div>

				<aside class="editor-panel">
					<div class="panel-header">
						<div>
							<p class="eyebrow">@(_isCreating ? "Nuovo record" : "Modifica record")</p>
							<h2>@(_isCreating ? "Aggiungi utente" : "Aggiorna informazioni")</h2>
						</div>

						<button type="button" class="ghost-button" @onclick="ResetEditor">Reset</button>
					</div>

					<EditForm Model="_editor" OnValidSubmit="SaveEditor">
						<DataAnnotationsValidator />
						<ValidationSummary />

						<div class="field-grid compact">
							<label>Username</label>
							<InputText class="form-control" @bind-Value="_editor.Username" placeholder="MarioRossi1975" />

							<label>Nome completo</label>
							<InputText class="form-control" @bind-Value="_editor.FullName" placeholder="Mario Rossi" />

							<label>Email</label>
							<InputText class="form-control" @bind-Value="_editor.Email" placeholder="mario.rossi@gmail.com" />

							<label>Nome device</label>
							<InputText class="form-control" @bind-Value="_editor.DeviceName" placeholder="ESP32-Mario Rossi" />

							<label>Location</label>
							<InputText class="form-control" @bind-Value="_editor.DeviceLocation" placeholder="Mario Rossi House" />

							<label>Password account</label>
							<InputText class="form-control" type="password" @bind-Value="_editor.Password" placeholder="userPaSsWoRd123" />

							<label>Stato device</label>
							<InputSelect class="form-select" @bind-Value="_editor.DeviceStatus">
								<option value="online">online</option>
								<option value="offline">offline</option>
								<option value="maintenance">maintenance</option>
							</InputSelect>
						</div>

						<div class="button-row">
							<button type="submit" class="primary-button">Salva</button>
							<button type="button" class="secondary-button" @onclick="CancelEditor">Annulla</button>
						</div>
					</EditForm>
				</aside>
			</div>
		</section>
	}
</div>

@code {
	private int _nextId = 4;
	private bool _isUnlocked;
	private int? _editingUserId;
	private bool _isCreating = true;

	private const string AdminPassword = "Admin2026!";

	private List<ManagedUser> _users = [];
	private readonly AdminLoginModel _login = new();
	
	private string _searchTerm = string.Empty;
	private UserEditorModel _editor = CreateEmptyEditor();
	
	protected override async Task OnInitializedAsync() {
		try {
			_users = await LoadUsersAsync();
			_nextId = _users.Count == 0 ? 1 : _users.Max(user => user.Id) + 1;
		} catch (Exception ex) {
			SnackBar.Add($"Errore di connessione: {ex.Message}", Severity.Error);
		}
	}

	private List<ManagedUser> FilteredUsers => _users
		.Where(user => string.IsNullOrWhiteSpace(_searchTerm)
			|| user.Username.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
			|| user.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
			|| user.DeviceName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
		.OrderBy(user => user.Username)
		.ToList();

	private void AttemptLogin() {
		if (!string.Equals(_login.Username.Trim(), "admin", StringComparison.OrdinalIgnoreCase)) {
			SnackBar.Add("Nome utente non valido. Usa admin.", Severity.Error);
			return;
		}

		if (!string.Equals(_login.Password, AdminPassword, StringComparison.Ordinal)) {
			SnackBar.Add("Password non corretta.", Severity.Error);
			return;
		}

		SnackBar.Add("Accesso admin completato.", Severity.Success);
		_isUnlocked = true;
	}

	private void BeginCreate() {
		_isCreating = true;
		_editingUserId = null;
		_editor = CreateEmptyEditor();
		SnackBar.Add("Modalità inserimento ON", Severity.Info);
	}

	private void BeginEdit(ManagedUser user) {
		_isCreating = false;
		_editingUserId = user.Id;
		_editor = new UserEditorModel {
			Username = user.Username,
			FullName = user.FullName,
			Email = user.Email,
			DeviceName = user.DeviceName,
			DeviceLocation = user.DeviceLocation,
			Password = user.Password,
			DeviceStatus = user.DeviceStatus
		};

		SnackBar.Add($"Stai modificando {user.Username}.", Severity.Info);
	}

	private void CancelEditor() {
		_isCreating = true;
		_editingUserId = null;
		_editor = CreateEmptyEditor();
	}

	private void ResetEditor() {
		CancelEditor();
		SnackBar.Add("Form resettato.", Severity.Info);
	}

	private async Task SaveEditor() {
		if (_isCreating) {
			var user = new ManagedUser
			{
				Id = _nextId++,
				Username = _editor.Username.Trim(),
				FullName = _editor.FullName.Trim(),
				Email = _editor.Email.Trim(),
				DeviceName = _editor.DeviceName.Trim(),
				DeviceLocation = _editor.DeviceLocation.Trim(),
				Password = _editor.Password,
				DeviceStatus = _editor.DeviceStatus
			};

			await UserStore.UpsertAsync(MapToRecord(user));
			_users = await LoadUsersAsync();

			SnackBar.Add($"Utente {user.Username} aggiunto.", Severity.Success);
		} else if (_editingUserId is not null) {
			var user = _users.First(item => item.Id == _editingUserId.Value);
			user.Username = _editor.Username.Trim();
			user.FullName = _editor.FullName.Trim();
			user.Email = _editor.Email.Trim();
			user.DeviceName = _editor.DeviceName.Trim();
			user.DeviceLocation = _editor.DeviceLocation.Trim();
			user.Password = _editor.Password;
			user.DeviceStatus = _editor.DeviceStatus;
			await UserStore.UpsertAsync(MapToRecord(user));
			_users = await LoadUsersAsync();

			SnackBar.Add($"Utente {user.Username} aggiornato.", Severity.Success);
		}

		CancelEditor();
	}

	private async Task DeleteUser(int id) {
		var user = _users.FirstOrDefault(item => item.Id == id);
		if (user is null)
			return;

		await UserStore.DeleteAsync(id);
		_users.Remove(user);

		if (_editingUserId == id)
			CancelEditor();

		SnackBar.Add($"Utente {user.Username} eliminato.", Severity.Success);
	}

	private static UserEditorModel CreateEmptyEditor() => new() {
		Password = string.Empty,
		DeviceStatus = "online"
	};

	private async Task<List<ManagedUser>> LoadUsersAsync() {
		var records = await UserStore.GetAllAsync();
		return records
			.Select(MapFromRecord)
			.OrderBy(user => user.Username)
			.ToList();
	}

	private static ManagedUser MapFromRecord(SharedUserRecord record) => new() {
		Id = record.Id,
		Username = record.Username,
		FullName = record.FullName,
		Email = record.Email,
		DeviceName = record.DeviceName,
		DeviceLocation = record.DeviceLocation,
		Password = record.Password,
		DeviceStatus = record.DeviceStatus
	};

	private static SharedUserRecord MapToRecord(ManagedUser user) => new() {
		Id = user.Id,
		Username = user.Username,
		FullName = user.FullName,
		Email = user.Email,
		Password = user.Password,
		DeviceName = user.DeviceName,
		DeviceLocation = user.DeviceLocation,
		DeviceStatus = user.DeviceStatus
	};

	private sealed class AdminLoginModel {
		public string Username { get; set; } = string.Empty;
		public string Password { get; set; } = string.Empty;
	}

	private sealed class UserEditorModel {
		[Required, StringLength(80, MinimumLength = 3)]
		public string Username { get; set; } = string.Empty;

		[Required, StringLength(120, MinimumLength = 3)]
		public string FullName { get; set; } = string.Empty;

		[Required, EmailAddress]
		public string Email { get; set; } = string.Empty;

		[Required, StringLength(120, MinimumLength = 3)]
		public string DeviceName { get; set; } = string.Empty;

		public string DeviceLocation { get; set; } = string.Empty;

		[Required, StringLength(80, MinimumLength = 4)]
		public string Password { get; set; } = string.Empty;

		[Required]
		public string DeviceStatus { get; set; } = string.Empty;
	}

	private sealed class ManagedUser {
		public int Id { get; set; }
		public string Username { get; set; } = string.Empty;
		public string FullName { get; set; } = string.Empty;
		public string Email { get; set; } = string.Empty;
		public string DeviceName { get; set; } = string.Empty;
		public string DeviceLocation { get; set; } = string.Empty;
		public string Password { get; set; } = string.Empty;
		public string DeviceStatus { get; set; } = string.Empty;
	}
}
