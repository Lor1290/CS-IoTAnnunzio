@page "/add-user"
@inject AdminService Admin
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Nuovo utente — IoT Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   OnClick='() => Nav.NavigateTo("/")' />
    <MudText Typo="Typo.h5">Aggiungi nuovo utente</MudText>
</MudStack>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                Dati utente
            </MudText>

            <MudTextField @bind-Value="_form.FullName"
                          Label="Nome completo"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Person" />

            <MudTextField @bind-Value="_form.Email"
                          Label="Email"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Class="mb-3"
                          Required="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email" />

            <MudTextField @bind-Value="_form.Password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                          Class="mb-3"
                          Required="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPwd = !_showPwd" />

            <MudSelect @bind-Value="_form.Role"
                       Label="Ruolo"
                       Variant="Variant.Outlined"
                       Class="mb-3">
                <MudSelectItem Value="@("viewer")">Viewer</MudSelectItem>
                <MudSelectItem Value="@("admin")">Admin</MudSelectItem>
            </MudSelect>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-4">
                <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Class="mr-2" />
                Dispositivo ESP32
            </MudText>

            <MudTextField @bind-Value="_form.DeviceName"
                          Label="Nome dispositivo"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Placeholder="es. ESP32-Aula3B"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Devices" />

            <MudTextField @bind-Value="_form.Location"
                          Label="Posizione"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Placeholder="es. Laboratorio IoT"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.LocationOn" />

            <MudTextField @bind-Value="_form.SerialId"
                          Label="Serial ID (esp32_serial_id)"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Required="true"
                          Placeholder="es. WOKWI-ESP32-004"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Tag" />

            <MudAlert Severity="Severity.Info" Dense="true">
                I sensori standard verranno aggiunti automaticamente.
            </MudAlert>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
}

@if (_success)
{
    <MudAlert Severity="Severity.Success" Class="mt-4">
        Utente creato con successo!
    </MudAlert>
}

<MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
    <MudButton Variant="Variant.Outlined"
               OnClick='() => Nav.NavigateTo("/")'>
        Annulla
    </MudButton>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save"
               OnClick="HandleSubmit"
               Disabled="_loading">
        @if (_loading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Salva utente
    </MudButton>
</MudStack>

@code {
    NewUserForm _form = new();
    bool _loading;
    bool _success;
    bool _showPwd;
    string? _error;

    async Task HandleSubmit()
    {
        _error   = null;
        _loading = true;

        var err = await Admin.AddUserAsync(_form);

        if (string.IsNullOrEmpty(err))
        {
            _success = true;
            _form    = new();  
            _loading = false;
        }
        else
        {
            _error   = err;
            _loading = false;
        }
    }
}
