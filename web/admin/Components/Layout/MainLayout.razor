@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Dark">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
        <MudText Typo="Typo.h6">IoT Admin Tool</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Solo uso locale</MudText>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-6 mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
